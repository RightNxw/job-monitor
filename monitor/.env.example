# Postgres connection string. The only required variable. The monitor exits
# without it. Any Postgres works; Supabase is what this was built against.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Claude API key. Powers the intel pipeline: parsing Discord/Reddit posts into
# structured hiring signals and reading Instagram stories. Without it, the job
# board scrapers still run but nothing gets parsed.
ANTHROPIC_API_KEY=

# Discord webhook to post new job postings to. Optional.
DISCORD_WEBHOOK_URL=

# Discord user account token, used to read intern-hiring channels.
# NOTE: automating a user account violates Discord's ToS and risks a ban. Use a
# burner account, or leave this unset to skip the Discord scraper entirely.
DISCORD_USER_TOKEN=

# Channels to read, comma-separated as `id:label` pairs.
# e.g. 123456789012345678:internships,987654321098765432:oa-reports
DISCORD_CHANNEL_IDS=

# Instagram session cookies as a JSON array, from a burner account. Used to
# fetch stories from job-posting accounts. Leave unset to skip.
INSTAGRAM_COOKIES=

# Minutes between scrape cycles. Default 15.
MONITOR_INTERVAL_MIN=15

# Path to a proxy list, one per line, as `host:port:user:pass` or a full
# http:// / socks5:// URL. Optional. Without it requests use your own IP.
MONITOR_PROXIES_FILE=./proxies.txt

# Port for the JSON API. Default 3000.
API_PORT=3000
