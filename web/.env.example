# Supabase project URL and publishable (anon) key. The dashboard reads the
# tables the monitor writes, so point these at the same database as the
# monitor's DATABASE_URL.
#
# Both are exposed to the browser by design, so make sure row level security is
# on and these tables are read-only for the anon role. Never put a service role
# key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
